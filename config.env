# Remote Server SSH details (Whitelisted for Jenkins IP)
SERVER_USER="deployer"
SERVER_HOST="98.70.45.119"

# Remote Docker & PostgreSQL details
CONTAINER_NAME="landmark-db"
DB_USER="postgres_local"
